---
const links = [
  { href: "#overview", label: "Overview" },
  { href: "#features", label: "Features" },
  { href: "#transparency", label: "Transparency" },
  { href: "#privacy", label: "Privacy" },
  { href: "#community", label: "Open Source" }
];
---

<header>
  <div class="nav-bar" role="navigation" aria-label="Primary navigation">
    <a class="logo" href="#overview">SiteSense</a>
    <nav class="nav-links">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <span class="nav-badge">Stay Secure</span>
  </div>
</header>

