{
  "name": "extension",
  "version": "1.0.0",
  "description": "SiteSense cross-browser WebExtension workspace",
  "scripts": {
    "clean": "rimraf dist .web-ext-artifacts",
    "dev:chrome": "vite --mode chrome",
    "dev:firefox": "vite --mode firefox",
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@samrum/vite-plugin-web-extension": "^5.1.1",
    "@types/chrome": "^0.1.27",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^24.10.0",
    "@types/webextension-polyfill": "^0.12.4",
    "@vitest/coverage-v8": "^4.0.8",
    "happy-dom": "^20.0.10",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.8"
  }
}
