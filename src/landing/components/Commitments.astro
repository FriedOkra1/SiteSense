---
const cards = [
  {
    variant: "positive",
    title: "We Do",
    highlight: "Open prompts & code",
    body: "Everything you see is fully documented and reviewable."
  },
  {
    variant: "positive",
    title: "We Do",
    highlight: "Session-only data",
    body: "All analysis lives in-memory and clears when you close the tab."
  },
  {
    variant: "negative",
    title: "We Don’t",
    highlight: "Collect profiles",
    body: "No accounts, telemetry, fingerprints, or tracking pixels. Ever."
  },
  {
    variant: "negative",
    title: "We Don’t",
    highlight: "Store policies",
    body: "We never keep website copies or LLM responses after your session."
  }
];
---

<section id="privacy" class="section">
  <div class="section-inner">
    <h2>Privacy Commitments</h2>
    <div class="privacy-grid">
      {cards.map((card) => (
        <article class={`privacy-card ${card.variant}`}>
          <h3>{card.title}</h3>
          <p class={card.variant === "positive" ? "highlight-green" : "highlight-red"}>
            {card.highlight}
          </p>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

